# ============================================================
# Dengar configuration — TEMPLATE
# Copy this file to .env and edit the values before first start:
#   cp .env.example .env
# Never commit .env to version control.
# ============================================================

# Password for the built-in "admin" account.
# Used only on first startup to create the admin login (the value
# itself is never stored; only an Argon2 hash is). Change the
# password afterwards from the admin Settings page.
# Pick a plain, memorable passphrase — this is NOT a hash.
ADMIN_INITIAL_PASSWORD=change-me-before-first-start

# Secret key used to sign admin session cookies.
# Any long random string works. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-value

# Root directory for ALL persistent data. The app creates and uses
# these subdirectories inside it automatically:
#   dengar.sqlite3   — SQLite database
#   audio/           — uploaded audio assets
#   config/          — exported YAML test configurations
#   backups/         — backup archives and recovery snapshots
#
# With Docker Compose, keep this as /data (the container path);
# it is bind-mounted to ./data on the host via docker-compose.yml.
# For local (non-Docker) runs, a relative or absolute path works
# (e.g. DATA_DIR=./data), and omitting it defaults to <repo>/data.
# If the configured path cannot be created outside Docker, the app logs a
# warning and falls back to <repo>/data.
DATA_DIR=/data

# Maximum accepted audio upload size, in megabytes.
MAX_AUDIO_UPLOAD_MB=100

# Set to true only when the frontend is served over HTTPS,
# so session cookies are marked Secure. Leave false for
# plain-HTTP LAN deployments.
SESSION_COOKIE_SECURE=false
